rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Feedback board ─────────────────────────────────────────────
    // Public read (the board is meant to be visible), authenticated writes
    // with SHAPE checks so arbitrary/oversized data can't be written.
    //
    // TODO (real enforcement): request.auth.token.email checks on authorEmail
    // so a user can only edit/delete their own posts, plus an admin claim.
    match /feedback_items/{itemId} {
      allow read: if true;

      allow create, update: if request.auth != null
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.detail is string
        && request.resource.data.detail.size() <= 2000
        && request.resource.data.authorEmail is string
        && request.resource.data.authorEmail.size() <= 100
        && request.resource.data.approved is bool
        && request.resource.data.upvoters is list
        && request.resource.data.upvoters.size() <= 10000
        && request.resource.data.comments is list;

      allow delete: if request.auth != null; // author/admin check needs the TODO above
    }

    // ── User data ──────────────────────────────────────────────────
    // A user document and everything under it (transactions, categories,
    // subscriptions, ask chat) belongs to exactly one signed-in identity.
    //
    // This previously read `allow read, write: if true` — public read/write on
    // every user's financial data — on the premise that the app was local-first
    // with no auth session. That premise no longer holds: the app authenticates
    // and syncUID() keys all cloud storage on the Firebase UID, which is the
    // same value as {userId} here.
    //
    // Consequence: a client with NO Firebase Auth session can no longer sync.
    // If anonymous guest sync is wanted, do it with anonymous auth, not by
    // reopening these rules.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /{document=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Everything else: closed. (The old top-level /transactions/{txId} rule was
    // dead — transactions live under users/<uid>/transactions.)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
